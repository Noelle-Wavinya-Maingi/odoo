<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit MRP Production Form View to add Omnifreight fields -->
        <record id="mrp_production_form_view_inherit_omni_ops" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit.omni.ops</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <!-- Add Omnifreight fields after user_id (person responsible) and before operations tab -->
                <xpath expr="//group[field[@name='user_id']]" position="after">
                    <group colspan="4">
                        <group string="Contact and Process Details" colspan="2">
                            <div style="display: flex; justify-content: space-between;">
                                <group colspan="1">
                                    <field name="partner_id" options="{'no_open': True, 'no_create': True}" />
                                    <field name="etd" widget="date"  placeholder="ETD"/>
                                </group>
                                <group colspan="1">
                                    <field name="seller_id" options="{'no_open': True, 'no_create': True}"  placeholder="John Doe"/>
                                    <field name="eta" widget="date"  placeholder="ETA"/> 
                                    <field name="incoterm_from" options="{'no_open': True, 'no_create': True}" />  
                                </group>
                                <group colspan="1">
                                    <field name="buyer_id" options="{'no_open': True, 'no_create': True}"  placeholder="John Doe"/>
                                    <field name="incoterm_to" options="{'no_open': True, 'no_create': True}" />
                                </group>
                            </div>
                            <!-- Hidden fields needed for visibility conditions -->
                            <field name="service_scope" invisible="1"/>
                            <field name="route_id" options="{'no_open': True, 'no_create': True}" invisible="1"/>
                        </group>
                        <!-- Information about the shipment -->
                        <group string="Shipment Information" colspan="2">
                            <group>
                                <field name="freight_carrier_id" domain="[('company_category', '=', 'supplier')]" />
                                <field name="booking_ref"  placeholder="Booking Reference"/>
                                <field name="carrier_agent_id" readonly="1" placeholder="Carrier Agent"/>
                                <field name="vessel_id"  placeholder="Vessel"/>
                            </group>
                            <group>
                                <field name="pol"  options="{'no_open': True, 'no_create': True}"/>
                                <field name="pod"  options="{'no_open': True, 'no_create': True}"/>
                            </group>
                        </group>

                        <group colspan="4">
                        <div style="display: flex; justify-content: space-between; width: 100%;">
                         <!-- Haulage Information - Only show for FOB and FOB+Freight scopes -->
                            <div style="width: 50%;">
                                <group colspan="2" invisible="service_scope not in ('fob', 'fob_freight', 'fob_lod', 'fob_freight_lod')">
                                    <group string="Haulage Information">
                                        <field name="transporter_id" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="city_from" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="pol" options="{'no_open': True, 'no_create': True}"/>
                                    </group>
                                </group>
                            </div>

                            <!-- Destination Information - Only show for Destination and Freight+Destination scopes -->
                            <div style="width: 50%;">
                                <group colspan="2" invisible="service_scope not in ('lod', 'freight_lod', 'fob_lod', 'fob_freight_lod')">
                                    <group string="Destination Information">
                                        <field name="supplier_id" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="city_to"  options="{'no_open': True, 'no_create': True}"/>
                                        <field name="pod"  options="{'no_open': True, 'no_create': True}"/>
                                    </group>
                                </group>
                            </div>
                        </div>
                        </group>

                        <!-- Information about the package -->
                        <group string="Package Details" colspan="2">
                            <group>
                                <field name="container_type" options="{'no_open': True, 'no_create': True}" />
                                <field name="contents" options="{'no_open': True, 'no_create': True}" widget="many2many_tags" />
                                <field name="content_classification" options="{'no_open': True, 'no_create': True}" />
                                <field name="soc" options="{'no_open': True, 'no_create': True}" />
                                <field name="weight"  placeholder="Weight"/>
                                <field name="volume"  placeholder="Volume"/> 
                            </group>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>    
    </data>
</odoo>