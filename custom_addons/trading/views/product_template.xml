<odoo>
    <record id="view_product_template_form_inherit_trading" model="ir.ui.view">
        <field name="name">product.template.form.trading.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='purchase_ok']" position="after">
                <field name="is_tradeable" string="Tradeable" />
                <label for="is_tradeable" string="Tradeable" class="o_form_label"/>
            </xpath>
        </field>
    </record>
</odoo>