<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_trading" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.trading</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Trading" string="Trading" name="trading">
                    <block title="Budgets" name="trading_budget_setting_container">
                        <setting id="trading_budgets_setting"
                                 string="Trade Budgets"
                                 help="Track planned vs. actual cost/revenue per trade, with automatic syncing from Bills, Invoices, and Expenses.">
                            <field name="module_trading_budget"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>