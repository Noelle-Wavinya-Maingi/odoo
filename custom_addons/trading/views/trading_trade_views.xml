<odoo>
    <record id="view_trading_trade_tree" model="ir.ui.view">
        <field name="name">trading.trade.list</field>
        <field name="model">trading.trade</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="trade_type" />
                <field name="lot_ids" widget="many2many_tags" />
                <field name="quantity" />
                <field name="currency_id" optional="hide" />
                <field name="price" />
                <field name="status" widget="badge" decoration-danger="status == 'closed'" decoration-success="status == 'confirmed'" decoration-info="status == 'draft'" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_trading_trade_form" model="ir.ui.view">
    <field name="name">trading.trade.form</field>
    <field name="model">trading.trade</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="status in ['confirmed', 'closed']" />
                <field name="status" widget="statusbar" options="{'clickable': True}" statusbar_visible="draft,confirmed,closed" />
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_purchase"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not purchase_id">
                        <field name="purchase_count" widget="statinfo" string="Purchase"/>
                    </button>
                    <button name="action_view_sales"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-dollar"
                        invisible="not sale_order_ids">
                        <field name="sale_count" widget="statinfo" string="Sales"/>
                    </button>
                    <button name="action_view_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="invoice_count == 0">
                        <field name="invoice_count" widget="statinfo" string="Customer Invoices" />
                    </button>
                    <button name="action_view_bills"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="bill_count == 0">
                        <field name="bill_count" widget="statinfo" string="Vendor Bills" />
                    </button>
                    <!-- Budget stat button lives in trading_budget/views/trading_trade_views.xml,
                         injected here via xpath, only when that optional module is installed. -->
                </div>
                <h1>
                    <field name="name" nolabel="1" default_focus="1" />
                </h1>
                <group col="2">
                    <group string="Trade Details">
                        <field name="trade_type" readonly="status in ['confirmed', 'closed']" />
                        <field name="lot_ids" readonly="status in ['confirmed', 'closed']" widget="many2many_tags" />
                        <field name="sale_order_ids" widget="many2many_tags" options="{'no_create': True}" readonly="1" invisible="1" />
                        <field name="invoice_ids" widget="many2many_tags" options="{'no_create': True}" readonly="1" invisible="1" />
                    </group>
                    <group string="Trade Metrics &amp; Financials" class="o_bg_light rounded">
                        <field name="product_id" readonly="status in ['confirmed', 'closed']" />
                        <label for="quantity" string="Quantity" />
                        <div class="o_row g-0 d-flex"> 
                            <field name="quantity" readonly="status != 'draft'" />
                            <field name="product_uom" />
                        </div>
                        <label for="on_hand_quantity" string="On Hand Quantity"/>
                        <div class="o_row g-0 d-flex">
                            <field name="on_hand_quantity" />
                            <field name="product_uom" />
                        </div>
                    </group>
                    <group string="Pricing Details">
                        <field name="currency_id" invisible="status != 'draft'" />
                        <field name="purchase_currency_id" invisible="status != 'draft'" />
                        <field name="sale_currency_id" invisible="status != 'draft'" />
                        <field name="price" readonly="status != 'draft'" />
                        <field name="sales_price" readonly="status != 'draft'" />
                        <field name="current_price" />
                    </group>
                    <group string="Target">
                        <label for="target_margin_percent" string="Target Margin"/>
                        <div class="o_row g-0 d-flex">
                            <field name="target_margin_percent" class="flex-grow-0" style="width: auto!important" />
                            <p class="flex-grow-0" style="width: auto!important;">%</p>
                        </div>
                    </group>
                </group>

                <!-- Hidden fields needed by cards but not shown in main group -->
                <field name="currency_id" invisible="1" />
                <field name="is_fully_matched" invisible="1" />
                <field name="has_budget" invisible="1" />

                <notebook>
                     <page string="Trade Summary" name="trade_summary">
                        <div class="row mt-4 d-flex align-items-stretch" string="Trade Summary">

                            <!-- Open Positions Card -->
                            <div class="col-12 col-lg-6 d-flex">
                                <div class="card w-100 h-100" style="border-left: 4px solid #0d6efd;">
                                    <div class="card-header" style="background-color: #e7f1ff;">
                                        <h5 class="mb-0"><i class="fa fa-chart-line me-1"/> Open Positions</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-2">
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Open Qty</strong>
                                                <field name="open_position_quantity" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Purchase Cost</strong>
                                                <field name="open_position_cost_basis" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Unrealized P&amp;L</strong>
                                                <field name="unrealized_pnl" widget="monetary" readonly="1" nolabel="1"
                                                       class="fw-bold"
                                                       decoration-success="unrealized_pnl &gt; 0"
                                                       decoration-danger="unrealized_pnl &lt; 0"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Market Price</strong>
                                                <field name="current_price" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Closed Positions Card -->
                            <div class="col-12 col-lg-6 d-flex">
                                <div class="card w-100 h-100" style="border-left: 4px solid #198754;">
                                    <div class="card-header" style="background-color: #d1e7dd;">
                                        <h5 class="mb-0"><i class="fa fa-check-circle me-1"/> Closed Positions</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="col-12 text-center">
                                            <strong style="display:block; font-size:11px; color:#6c757d;">Additional Costs
                                                <span class="fa fa-info-circle" title="Subtracted from Realized P&amp;L alongside CostBasis. Realized P&amp;L = Sales Value - Cost Basis - Additional Costs."/>
                                            </strong>
                                            <field name="additional_costs" widget="monetary" readonly="1" nolabel="1" class="fw-bold" options="{'currency_field': 'currency_id'}"/>
                                        </div>
                                        <hr/>
                                        <div class="row g-2">
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Sold Qty</strong>
                                                <field name="total_sold_quantity" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Sales Value</strong>
                                                <field name="total_sales_value" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Realized P&amp;L</strong>
                                                <field name="realized_pnl" widget="monetary" readonly="1" nolabel="1"
                                                       class="fw-bold"
                                                       decoration-success="realized_pnl &gt; 0"
                                                       decoration-danger="realized_pnl &lt; 0"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Cost Basis</strong>
                                                <field name="total_sales_cost_basis" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Summary Card -->
                            <div class="col-12 col-lg-6 d-flex" style="margin-top: 2rem;" invisible="has_budget">
                                <div class="card w-100 h-100" style="border-left: 4px solid #ffc107;">
                                    <div class="card-header" style="background-color: #fff3cd;">
                                        <h5 class="mb-0"><i class="fa fa-calculator me-1"/> Summary</h5>
                                    </div>
                                    <div class="card-body">
                                         <div class="col-12 text-center">
                                            <strong style="display:block; font-size:11px; color:#6c757d;">Additional Revenue
                                                <span class="fa fa-info-circle" title="Additional revenue generated from the trade."/>
                                            </strong>
                                            <field name="additional_revenue" widget="monetary" readonly="1" nolabel="1" class="fw-bold" options="{'currency_field': 'currency_id'}"/>
                                        </div>
                                        <hr/>
                                        <div class="row g-2">
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Total P&amp;L</strong>
                                                <field name="total_pnl" widget="monetary" readonly="1" nolabel="1"
                                                       class="fw-bold"
                                                       decoration-success="total_pnl &gt; 0"
                                                       decoration-danger="total_pnl &lt; 0"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">P&amp;L %</strong>
                                                <field name="pnl_percentage" readonly="1" nolabel="1"
                                                       class="fw-bold"
                                                       decoration-success="pnl_percentage &gt; 0"
                                                       decoration-danger="pnl_percentage &lt; 0"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Avg Sale Price
                                                    <span class="fa fa-info-circle" title="Same average sale price shown in Pricing Details, converted to the reporting currency. Currency differences are expected if Sales Price was set in a different currency."/>
                                                </strong>
                                                <field name="average_sale_price" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Fully Matched?</strong>
                                                <field name="is_fully_matched" readonly="1" nolabel="1" widget="checkbox" class="fw-bold"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Margin Target Card -->
                            <div class="col-12 col-lg-6 d-flex" style="margin-top: 2rem;" invisible="has_budget">
                                <div class="card w-100 h-100" style="border-left: 4px solid #6f42c1;">
                                    <div class="card-header" style="background-color: #ede7f6;">
                                        <h5 class="mb-0"><i class="fa fa-bullseye me-1"/> Margin Target</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-2">
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Target P&amp;L</strong>
                                                <field name="target_pnl" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                 <strong style="display:block; font-size:11px; color:#6c757d;">Target Sales Price
                                                    <span class="fa fa-info-circle" title="Per-unit sale price needed to hit your Target Margin %, given average cost per unit. Compare against Sales Price / Avg Sale Price in the Summary card."/>
                                                </strong>
                                                <field name="target_sales_price" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                            <div class="col-6 text-center" invisible="trade_type != 'long'">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Target Purchase Price
                                                    <span class="fa fa-info-circle" title="Most you can pay to cover this position andstill hit your Target Margin %, given the sale price already locked in."/>
                                                </strong>
                                                <field name="target_purchase_price" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            </div>
                                            <div class="col-6 text-center" invisible="trade_type != 'short'">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Variance vs. Target
                                                    <span class="fa fa-info-circle" title="Total P&amp;L (Summary card) - Target P&amp;L. Positive = beating target, negative = falling short."/>
                                                </strong>
                                                <field name="margin_pnl_variance" widget="monetary" readonly="1" nolabel="1"
                                                       class="fw-bold"
                                                       decoration-success="margin_pnl_variance &gt; 0"
                                                       decoration-danger="margin_pnl_variance &lt; 0"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <strong style="display:block; font-size:11px; color:#6c757d;">Variance %</strong>
                                                <field name="margin_pnl_variance_percent" readonly="1" nolabel="1"
                                                       class="fw-bold"
                                                       decoration-success="margin_pnl_variance_percent &gt; 0"
                                                       decoration-danger="margin_pnl_variance_percent &lt; 0"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                     </page>
                     <!-- Budget page lives in trading_budget/views/trading_trade_views.xml,
                          injected here via xpath, only when that optional module is installed. -->
                </notebook>
            </sheet>
            <chatter />
        </form>
    </field>
</record>

<!-- Pivot View -->
 <record id="view_trading_trade_graph" model="ir.ui.view">
        <field name="name">trading.trade.graph</field>
        <field name="model">trading.trade</field>
        <field name="arch" type="xml">
            <graph string="Trading Performance" type="bar" stacked="0">
                <field name="product_id" type="row"/>
                <field name="trade_type" type="col"/>
                <field name="total_pnl" type="measure"/>
                <field name="realized_pnl" type="measure"/>
                <field name="unrealized_pnl" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════════════ ENHANCED PIVOT VIEW ═══════════════════ -->
    <record id="view_trading_trade_pivot" model="ir.ui.view">
        <field name="name">trading.trade.pivot</field>
        <field name="model">trading.trade</field>
        <field name="arch" type="xml">
            <pivot string="Trading Analysis" display_quantity="true">
                <field name="product_id" type="row"/>
                <field name="trade_type" type="row"/>
                <field name="status" type="row"/>
                <field name="create_date" type="col" interval="month"/>
                <field name="quantity" type="measure"/>
                <field name="price" type="measure"/>
                <field name="total_purchase_cost" type="measure"/>
                <field name="total_sales_value" type="measure"/>
                <field name="additional_costs" type="measure"/>
                <field name="additional_revenue" type="measure"/>
                <field name="realized_pnl" type="measure"/>
                <field name="unrealized_pnl" type="measure"/>
                <field name="total_pnl" type="measure"/>
                <field name="pnl_percentage" type="measure"/>
                <field name="target_pnl" type="measure"/>
                <field name="margin_pnl_variance" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════════════ KANBAN VIEW (visual dashboard cards) ═══════════════════ -->
    <record id="view_trading_trade_kanban" model="ir.ui.view">
        <field name="name">trading.trade.kanban</field>
        <field name="model">trading.trade</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="trade_type"/>
                <field name="status"/>
                <field name="product_id"/>
                <field name="total_pnl"/>
                <field name="pnl_percentage"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-3"
                             t-attf-style="border-left: 4px solid {{record.total_pnl.raw_value >= 0 ? '#198754' : '#dc3545'}};">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong><field name="name"/></strong>
                                <span class="badge"
                                      t-attf-class="badge {{record.trade_type.raw_value == 'long' ? 'bg-success' : 'bg-danger'}}">
                                    <field name="trade_type"/>
                                </span>
                            </div>
                            <div class="text-muted small mb-2">
                                <field name="product_id"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>
                                    <strong style="font-size: 11px; color: #6c757d; display:block;">Total P&amp;L</strong>
                                    <field name="total_pnl" widget="monetary"
                                           t-attf-class="fw-bold {{record.total_pnl.raw_value >= 0 ? 'text-success' : 'text-danger'}}"/>
                                </div>
                                <div class="text-end">
                                    <strong style="font-size: 11px; color: #6c757d; display:block;">P&amp;L %</strong>
                                    <field name="pnl_percentage"
                                           t-attf-class="fw-bold {{record.pnl_percentage.raw_value >= 0 ? 'text-success' : 'text-danger'}}"/>
                                </div>
                            </div>
                            <div class="mt-2">
                                <span class="badge"
                                      t-attf-class="badge {{record.status.raw_value == 'draft' ? 'bg-light text-dark' : record.status.raw_value == 'confirmed' ? 'bg-info' : 'bg-secondary'}}">
                                    <field name="status"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════ SEARCH VIEW (filters + group by for reporting) ═══════════════════ -->
    <record id="view_trading_trade_search" model="ir.ui.view">
        <field name="name">trading.trade.search</field>
        <field name="model">trading.trade</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="trade_type"/>

                <separator/>
                <filter string="Long Trades" name="filter_long" domain="[('trade_type', '=', 'long')]"/>
                <filter string="Short Trades" name="filter_short" domain="[('trade_type', '=', 'short')]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Closed" name="filter_closed" domain="[('status', '=', 'closed')]"/>
                <separator/>
                <filter string="Profitable" name="filter_profitable" domain="[('total_pnl', '&gt;', 0)]"/>
                <filter string="Loss-making" name="filter_loss" domain="[('total_pnl', '&lt;', 0)]"/>
                <separator/>
                <filter string="Fully Matched" name="filter_matched" domain="[('is_fully_matched', '=', True)]"/>
                <separator/>
                <filter string="Product" name="groupby_product" context="{'group_by': 'product_id'}"/>
                <filter string="Trade Type" name="groupby_trade_type" context="{'group_by': 'trade_type'}"/>
                <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                <filter string="Creation Month" name="groupby_month" context="{'group_by': 'create_date:month'}"/>
            </search>
        </field>
    </record>
    <!-- ═══════════════════ REPORTING ACTION ═══════════════════ -->
    <record id="action_trading_trade_reporting" model="ir.actions.act_window">
        <field name="name">Trading Reporting</field>
        <field name="res_model">trading.trade</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_trading_trade_search"/>
        <field name="context">{'search_default_filter_confirmed': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No trades to report on yet
            </p>
            <p>
                Once you create and confirm trades, you'll see performance analytics here.
            </p>
        </field>
    </record>

</odoo>