<odoo>
    <record id="view_stock_picking_deliveries_futures_form" model="ir.ui.view">
        <field name="name">stock.picking.delivery.futures.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="picking_type_code" invisible="1" />
                <!-- <field name="futures_id" invisible="picking_type_code in ['incoming', 'internal']" /> -->
            </xpath>
        </field>
    </record>
</odoo>