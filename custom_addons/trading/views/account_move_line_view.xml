<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add trade_id to account.move.line model -->
    <record id="view_move_form_add_trade_to_invoice_lines" model="ir.ui.view">
        <field name="name">account.move.form.add.trade.to.invoice.lines</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add trade_id field to the invoice lines list -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="trade_id" 
                       string="Trade"
                       optional="show"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            
            <!-- Also add to the form view of individual lines (for mobile) -->
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="after">
                <field name="trade_id" 
                       string="Trade"
                       options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//group[@name='utm_link']" position="after">
                <group name="group_trade_info" string="Trade Information">
                    <field name="is_from_purchase_order" readonly="1" />
                    <field name="is_from_sale_order" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>