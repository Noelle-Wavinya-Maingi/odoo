<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Expense Form View -->
    <record id="hr_expense_view_form_inherit_trading" model="ir.ui.view">
        <field name="name">hr.expense.view.form.inherit.trading</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="trade_id"
                       options="{'no_create': True}"
                       readonly="not is_editable"/>
                <field name="budget_line_id"
                       string="Budget Line"
                       readonly="not is_editable"
                       invisible="not trade_id"/>
            </xpath>
        </field>
    </record>
</odoo>
