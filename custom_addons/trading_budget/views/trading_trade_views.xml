<odoo>
    <record id="view_trading_trade_form_budget" model="ir.ui.view">
        <field name="name">trading.trade.form.inherit.trading.budget</field>
        <field name="model">trading.trade</field>
        <field name="inherit_id" ref="trading.view_trading_trade_form"/>
        <field name="arch" type="xml">

            <!-- Add the Budget stat button into the existing button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_budget"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calculator"
                    invisible="not has_budget">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Budget</span>
                        <field name="budget_state" widget="badge"/>
                    </div>
                </button>
            </xpath>

            <!-- Add the Budget page as the last notebook page -->
            <xpath expr="//page[@name='trade_summary']" position="after">
                <page string="Budget">
                    <div class="mt-3 p-2 px-3 rounded d-flex justify-content-between align-items-center" style="background-color: #f1f3f5;" invisible="has_budget">
                        <span class="text-muted">No budget yet for this trade.</span>
                        <button name="action_create_budget" type="object" string="Create Budget" class="btn-primary"/>
                    </div>

                    <div class="mt-3 p-2 px-3 rounded d-flex justify-content-between align-items-center" style="background-color: #f1f3f5;" invisible="not has_budget">
                        <span>
                            Budget
                            <field name="budget_id" readonly="1" nolabel="1" class="fw-bold" style="display:inline-block"/>
                            <field name="budget_state" widget="badge" nolabel="1" style="display:inline-block; margin-left:0.5rem"
                                   decoration-success="budget_state == 'closed'"
                                   decoration-info="budget_state == 'confirmed'"
                                   decoration-muted="budget_state == 'draft'"/>
                            <br/><br/>
                            <p class="text-muted"><em>Tracked as its own record so it can carry a reference number, status, and analytic account.</em></p>
                        </span>
                        <button name="action_view_budget" type="object" string="Open Budget" class="btn-primary"/>
                    </div>
                </page>
            </xpath>

        </field>
    </record>
</odoo>