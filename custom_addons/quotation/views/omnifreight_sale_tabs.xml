<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">omnifreight.quotation.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='order_lines']" position="before">
                <page name="fob" string="Services"
                    context="{'active_view': 'fob'}">
                   
                </page>
            </xpath>

            <xpath expr="//page[@name='order_lines']" position="attributes">
                <attribute name="invisible">hide_order_lines</attribute>
            </xpath>

            <xpath expr="//field[@name='validity_date']" position="replace">
                <field name="validity_date" required="1" />
            </xpath>
        </field>
    </record>
</odoo>