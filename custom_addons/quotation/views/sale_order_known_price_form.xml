<odoo>

    <!-- Form View -->
    <record id="view_known_price_form" model="ir.ui.view">
        <field name="name">sale.order.known.price.form</field>
        <field name="model">sale.order.known.price</field>
        <field name="arch" type="xml">
            <form string="Known Prices">
                <header>
                    <button name="action_duplicate_rate" type="object" string="Duplicate Rate" 
                            class="btn-primary" invisible="not show_expiry_warning" 
                            help="Create a copy of this expired rate with a new validity date"/>
                </header>
                <sheet>
                    <group>
                        <group invisible="1">
                            <field name="is_selected" />
                            <field name="known_price_id" />
                            <field name="sale_order_id"/>
                            <field name="show_expiry_warning" invisible="1" />
                        </group>  
                        <group>
                            <field name="carrier_id" domain="[('company_category', '=', 'supplier')]" placeholder="Carrier" readonly="show_expiry_warning"/>
                            <field name="transit_time" placeholder="Transit Time" readonly="show_expiry_warning"/>
                            <field name="departure_frequency" placeholder="Departure Frequency" readonly="show_expiry_warning"/>
                            <field name="valid_until" widget='date' placeholder="Valid Until" 
                                   decoration-danger="show_expiry_warning" readonly="show_expiry_warning"/>
                        </group>
                        <group>
                            <field name="container_type" placeholder="Container Type" readonly="show_expiry_warning"/>
                            <field name="price" widget="monetary" option="{'currency_field': 'currency_id'}" placeholder="Price" readonly="show_expiry_warning"/>
                            <field name="currency_id" readonly="show_expiry_warning"/>
                            <field name="imo_surcharge_ft"  widget="monetary" option="{'currency_field': 'currency_id'}" placeholder="Hazmat Surcharge" readonly="show_expiry_warning"/>
                            <field name="soc_tariff" widget="monetary" option="{'currency_field': 'currency_id'}" placeholder="SOC Tariff" readonly="show_expiry_warning"/>
                        </group>
                        <group>
                            <field name="notes" placeholder="Notes" readonly="show_expiry_warning"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
