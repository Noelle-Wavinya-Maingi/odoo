<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View for Omnifreight Miscellaneous Costs -->
    <record id="view_omnifreight_misc_costs_list" model="ir.ui.view">
        <field name="name">omnifreight.special.costs.list</field>
        <field name="model">omnifreight.special.costs</field>
        <field name="arch" type="xml">
            <list string="Miscellaneous Costs">
                <field name="name"/>
                <!-- <field name="cost_type" widget="many2many_tags"/> -->
                <field name="omnifreight_extra_cost_price_per_unit"/>
            </list>
        </field>
    </record>

    <!-- Form View for Omnifreight Miscellaneous Costs -->
    <record id="view_omnifreight_misc_costs_form" model="ir.ui.view">
        <field name="name">omnifreight.special.costs.form</field>
        <field name="model">omnifreight.special.costs</field>
        <field name="arch" type="xml">
            <form string="Miscellaneous Cost">
                <sheet>
                    <group>
                        <group colsspan="2" string="Cost Details">
                            <field name="name"/>
                            <field name="omnifreight_extra_cost_price_per_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id"/>
                        </group>
                        <group colsspan="2" string="Cost Type">
                            <group>
                                <field name="is_freight_cost" widget="checkbox"/>
                                <field name="is_fob_cost" widget="checkbox"/>
                                <field name="is_lod_cost" widget="checkbox"/>
                            </group>
                            <group>
                                <field name="is_port_cost" widget="checkbox"/>
                                <field name="is_soc_cost" widget="checkbox"/>
                            </group>
                        </group>
                        <group colsspan="2" string="Extra Details">
                            <field name="port_id" widget="many2one" invisible="not is_port_cost" />
                            <field name="container_type" widget="selection" options="{'no_create': True}" invisible="not is_port_cost"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View for Omnifreight Special Cost Presets -->
    <record id="view_omnifreight_special_cost_preset_list" model="ir.ui.view">
        <field name="name">omnifreight.special.cost.preset.list</field>
        <field name="model">omnifreight.special.cost.preset</field>
        <field name="arch" type="xml">
            <list string="Special Cost Presets">
                <field name="name"/>
                <field name="default_unit_price"/>
                <field name="is_freight_cost"/>
                <field name="is_fob_cost"/>
                <field name="is_lod_cost"/>
                <field name="is_port_cost"/>
                <field name="is_soc_cost"/>
                <field name="is_route_cost"/>
                <field name="route_id"/>
                <field name="port_id"/>
                <field name="container_type"/>
            </list>
        </field>
    </record>

    <!-- Form View for Omnifreight Special Cost Presets -->
    <record id="view_omnifreight_special_cost_preset_form" model="ir.ui.view">
        <field name="name">omnifreight.special.cost.preset.form</field>
        <field name="model">omnifreight.special.cost.preset</field>
        <field name="arch" type="xml">
            <form string="Special Cost Preset">
                <sheet>
                    <group>
                        <group colsspan="2" string="Cost Details">
                            <field name="name"/>
                            <field name="default_unit_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id"/>
                        </group>
                        <group colsspan="2" string="Cost Type">
                            <group>
                                <field name="is_freight_cost" widget="checkbox"/>
                                <field name="is_fob_cost" widget="checkbox"/>
                                <field name="is_lod_cost" widget="checkbox"/>
                            </group>
                            <group>    
                                <field name="is_port_cost" widget="checkbox"/>
                                 <field name="is_soc_cost" widget="checkbox"/>
                                 <field name="is_route_cost" widget="checkbox"/>
                            </group> 
                        </group>
                        <group colsspan="2" string="Extra Details">
                            <field name="port_id" widget="many2one" invisible="not is_port_cost" />
                            <field name="container_type" widget="selection" options="{'no_create': True}" />
                            <field name="route_id" widget="many2one" invisible="not is_route_cost" options="{'no_create': True}" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open the Miscellaneous Costs -->
    <record id="action_omnifreight_misc_costs" model="ir.actions.act_window">
        <field name="name">Miscellaneous Costs</field>
        <field name="res_model">omnifreight.special.costs</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Manage miscellaneous costs for Omnifreight operations.</p>
        </field>
    </record>

    <!-- Action to open the Special Cost Presets -->
    <record id="action_omnifreight_special_cost_presets" model="ir.actions.act_window">
        <field name="name">Additional Services</field>
        <field name="res_model">omnifreight.special.cost.preset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Manage preset miscellaneous costs for Omnifreight operations.</p>
        </field>
    </record>

    <!-- Menuitem under Sales Configuration for Special Cost Presets -->
    <menuitem id="menu_omnifreight_special_cost_presets"
              name="Additional Services"
              parent="sale.menu_sale_config"
              action="action_omnifreight_special_cost_presets"
              sequence="30"/>
</odoo>
