<odoo>
    <!-- Actions -->
    <record id="action_continents" model="ir.actions.act_window">
        <field name="name">Continents</field>
        <field name="res_model">geographical.continent</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="quotation.view_continent_list"/>
    </record>

    <record id="action_subregions" model="ir.actions.act_window">
        <field name="name">Subregions</field>
        <field name="res_model">un.subregion</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="quotation.view_un_subregion_list"/>
    </record>

    <record id="action_countries" model="ir.actions.act_window">
        <field name="name">Countries</field>
        <field name="res_model">unloc.country</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="quotation.view_unloc_country_list"/>
    </record>

    <record id="action_cities" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">unloc.city</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="quotation.view_unloc_city_list"/>
    </record>

    <!-- Menus -->
    <menuitem id="menu_geographical_data"
              name="Geographical Data"
              parent="base.menu_administration"
              sequence="100"/>

    <menuitem id="menu_continents"
              name="Continents"
              parent="menu_geographical_data"
              action="action_continents"
              sequence="10"/>

    <menuitem id="menu_subregions"
              name="Subregions"
              parent="menu_geographical_data"
              action="action_subregions"
              sequence="20"/>

    <menuitem id="menu_countries"
              name="Countries"
              parent="menu_geographical_data"
              action="action_countries"
              sequence="30"/>

    <menuitem id="menu_cities"
              name="Cities"
              parent="menu_geographical_data"
              action="action_cities"
              sequence="40"/>          
</odoo>
